{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "include": ["*.ts", "src/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
